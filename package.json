{
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "git-cliff": "^2.13.1",
    "husky": "^9.1.7"
  },
  "config": {
  "commitizen": {
    "path": "./node_modules/cz-conventional-changelog"
  }
  },
  "scripts": {
    "prepare": "husky",
    "commit": "git-cz",
    "changelog": "git-cliff -o CHANGELOG.md"
  }
}
